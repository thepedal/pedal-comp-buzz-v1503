<Project Sdk="Microsoft.NET.Sdk">

  <!-- Pedal Comp for Jeskola Buzz 1503 (32-bit).
       Buzz 1503 hosts managed machines on .NET Framework, so this targets
       net48 / x86. A .NET 10 build does not load in Buzz 1503. -->

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Pedal Comp.NET</AssemblyName>
    <RootNamespace>WDE.PedalComp</RootNamespace>
    <Version>1.1.0</Version>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>MSB3277</NoWarn>
    <BuzzDir Condition="'$(BuzzDir)' == ''">C:\Program Files (x86)\Jeskola\Buzz</BuzzDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Build-time only; nothing extra is deployed. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- WPF for the embedded meter panel. Plain framework references on net48. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />

    <!-- Buzz SDK assemblies: resolved from the Buzz install, never copied. -->
    <Reference Include="BuzzGUI.Interfaces">
      <HintPath>$(BuzzDir)\BuzzGUI.Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BuzzGUI.Common">
      <HintPath>$(BuzzDir)\BuzzGUI.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Effect: deploy to Gear\Effects. Build elevated with Buzz closed. -->
  <Target Name="DeployToBuzz" AfterTargets="Build">
    <Message Text="Deploying $(TargetFileName) -> $(BuzzDir)\Gear\Effects\" Importance="high" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFolder="$(BuzzDir)\Gear\Effects\"
          ContinueOnError="true" />
  </Target>

</Project>
